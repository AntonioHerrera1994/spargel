---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Spargel de Los Planes | Premium Asparagus from BCS",
  description = "Asparagus sustainably grown in Valle de Los Planes, Baja California Sur, Mexico. From field to table with passion, integrity, and agricultural innovation.",
  image = "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esparrago.webp",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = "https://esparragosdelosplanes.com";

const esPath = Astro.url.pathname.replace(/^\/en/, "") || "/";
const enPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<meta name="generator" content={Astro.generator} />

	<!-- Title & description -->
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="author" content="Spargel de Los Planes" />
	<meta name="theme-color" content="#2d5016" />

	<!-- Indexing -->
	{noindex
		? <meta name="robots" content="noindex, nofollow" />
		: <meta name="robots" content="index, follow, max-image-preview:large" />
	}

	<!-- Canonical -->
	<link rel="canonical" href={canonicalURL} />

	<!-- Hreflang: EN/ES + x-default -->
	<link rel="alternate" hreflang="en" href={`${siteURL}${enPath}`} />
	<link rel="alternate" hreflang="es" href={`${siteURL}${esPath}`} />
	<link rel="alternate" hreflang="x-default" href={`${siteURL}${esPath}`} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Spargel de Los Planes" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:locale" content="en_US" />
	<meta property="og:locale:alternate" content="es_MX" />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={new URL(image, Astro.site)} />

	<!-- Preconnect fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

	<!-- JSON-LD -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "Spargel de Los Planes",
		"url": siteURL,
		"logo": `${siteURL}/images/logo.png`,
		"description": description,
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Valle de Los Planes",
			"addressRegion": "Baja California Sur",
			"addressCountry": "MX"
		},
		"sameAs": []
	})} />

	<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-6EDP224E8E"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-6EDP224E8E');
</script>
</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
