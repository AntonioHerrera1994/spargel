---
import '../styles/global.css';

// Props para poder personalizar cada página (recetas, home, etc.)
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Spargel de Los Planes | Espárragos Premium de Valle de Los Planes, BCS",
  description = "Espárragos premium cultivados de forma sustentable en Valle de Los Planes, Baja California Sur. Del campo a tu mesa con pasión, integridad e innovación agrícola.",
  image = "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esparrago.webp",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = "https://esparragosdelosplanes.com";

// Detecta si estamos en la versión en inglés para el hreflang correcto
const isEnglish = Astro.url.pathname.startsWith("/en");
const esPath = isEnglish ? Astro.url.pathname.replace(/^\/en/, "") || "/" : Astro.url.pathname;
const enPath = isEnglish ? Astro.url.pathname : `/en${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`;
---
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />

	<!-- Título y descripción -->
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="author" content="Spargel de Los Planes" />
	<meta name="theme-color" content="#2d5016" />

	<!-- Indexación -->
	{noindex
		? <meta name="robots" content="noindex, nofollow" />
		: <meta name="robots" content="index, follow, max-image-preview:large" />
	}

	<!-- Canonical -->
	<link rel="canonical" href={canonicalURL} />

	<!-- Hreflang: ES/EN + x-default -->
	<link rel="alternate" hreflang="es" href={`${siteURL}${esPath}`} />
	<link rel="alternate" hreflang="en" href={`${siteURL}${enPath}`} />
	<link rel="alternate" hreflang="x-default" href={`${siteURL}${esPath}`} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Spargel de Los Planes" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={new URL(image, Astro.site)} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:locale" content={isEnglish ? "en_US" : "es_MX"} />
	<meta property="og:locale:alternate" content={isEnglish ? "es_MX" : "en_US"} />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={new URL(image, Astro.site)} />

	<!-- Fuentes: preconnect para performance -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

	<!-- JSON-LD: datos estructurados para Google -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "Spargel de Los Planes",
		"url": siteURL,
		"logo": `${siteURL}/images/logo.png`,
		"description": description,
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Valle de Los Planes",
			"addressRegion": "Baja California Sur",
			"addressCountry": "MX"
		},
		"sameAs": []
	})} />
</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
