---
import "../styles/hero.css";

const slides = [
  { src: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp1.webp", alt: "Product close-up" },
  { src: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp2.webp", alt: "Premium packaging" },
  { src: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp3.webp", alt: "Fresh cut" },
  { src: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp4.webp", alt: "Harvest in the valley" },
];
---

<section class="hero">
  <div class="hero__grid">
    <!-- Left column: green card with copy -->
    <div class="hero__card">
      <div class="hero__eyebrow">
        <span class="hero__eyebrow-line"></span>
        FROM MEXICO, FOR MEXICO
        <span class="hero__eyebrow-line"></span>
      </div>

      <h1 class="hero__title">
        The Unmatched Taste of Nature, from the Valle de Los Planes
      </h1>

      <p class="hero__desc">
        Born from Finca Palo Verde, Spargel de Los Planes grows premium
        asparagus with passion in Baja California Sur, innovating the
        agricultural industry with precise strategies and a real commitment
        to the land.
      </p>

      <div class="hero__actions">
        <a href="https://wa.link/fzev4z" class="btn btn--solid">
          Request a Wholesale Quote <span class="icon" aria-hidden="true">↗</span>
        </a>
        <a href="#about" class="btn btn--outline">
          Discover Our Origin <span class="icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right column: background image + floating slider -->
    <div class="hero__visual">
      <figure class="hero__bg">
        <img
          src="https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esparrago.webp"
          alt="Asparagus Farm"
          loading="lazy"
        />
      </figure>

      <div class="hero__slider" id="hero-slider">
        <div class="hero__slider-track" id="slider-track">
          {
            slides.map((slide) => (
              <div class="hero__slide">
                <img src={slide.src} alt={slide.alt} loading="lazy" />
              </div>
            ))
          }
        </div>
      </div>

      <div class="hero__nav">
        <button type="button" class="nav-btn nav-btn--prev" id="prev-btn" aria-label="Previous image">‹</button>
        <button type="button" class="nav-btn nav-btn--next is-active" id="next-btn" aria-label="Next image">›</button>
      </div>
    </div>
  </div>
</section>

<script> import '../scripts/heri'
</script>