---
import "../styles/misionvis.css";

const pillars = [
  {
    label: "MISSION",
    title: "Delighting All of Mexico",
    text: "With our organic, sustainable products, offering efficient and strategic solutions to provide excellent quality without impacting the environment.",
    image: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp3.webp",
  },
  {
    label: "VISION",
    title: "Leaders in Baja California Sur",
    text: "To be the leader in organic food production in Baja California Sur, selling primarily in our local market and growing progressively into other Mexican states, while remaining sustainable and competitive.",
    image: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp4.webp",
  },
];

const values = [
  {
    title: "Passion",
    text: "The driving force behind every harvest.",
    icon: "heart",
  },
  {
    title: "Integrity",
    text: "Transparency in every process.",
    icon: "shield",
  },
  {
    title: "Intelligence",
    text: "Decisions grounded in data and precision.",
    icon: "spark",
  },
  {
    title: "Innovation",
    text: "New strategies for Mexican agriculture.",
    icon: "bulb",
  },
  {
    title: "Sustainability",
    text: "We care for the environment as we care for you.",
    icon: "leaf",
  },
];
---

<section class="mv" id="mission-vision">
  <div class="mv__header">
    <div class="mv__eyebrow">
      <span class="mv__eyebrow-line"></span>
      OUR COMPASS
      <span class="mv__eyebrow-line"></span>
    </div>
    <h2 class="mv__title">Mission, Vision & Values</h2>
  </div>

  <!-- Mission & Vision grid -->
  <div class="mv__pillars">
    {
      pillars.map((pillar) => (
        <div class="mv-pillar">
          <img
            src={pillar.image}
            alt={pillar.title}
            class="mv-pillar__image"
            loading="lazy"
          />
          <div class="mv-pillar__overlay"></div>
          <div class="mv-pillar__content">
            <span class="mv-pillar__label">{pillar.label}</span>
            <h3 class="mv-pillar__title">{pillar.title}</h3>
            <p class="mv-pillar__text">{pillar.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Values grid -->
  <div class="mv__values">
    {
      values.map((value) => (
        <div class="value-card">
          <div class="value-card__icon">
            {value.icon === "heart" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" />
              </svg>
            )}
            {value.icon === "shield" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
              </svg>
            )}
            {value.icon === "spark" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8" />
              </svg>
            )}
            {value.icon === "bulb" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 2Z" />
              </svg>
            )}
            {value.icon === "leaf" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 4 13V7a1 1 0 0 1 1-1h6a7 7 0 0 1 7 7v0a7 7 0 0 1-7 7Z" />
                <path d="M4 13c6 0 8-4 12-4" />
              </svg>
            )}
          </div>
          <h4 class="value-card__title">{value.title}</h4>
          <p class="value-card__text">{value.text}</p>
        </div>
      ))
    }
  </div>
</section>