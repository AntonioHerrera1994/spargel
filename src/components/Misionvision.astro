---
import "../styles/misionvis.css";

const pillars = [
  {
    label: "MISIÓN",
    title: "Deleitar a Todo México",
    text: "Con nuestros productos orgánicos y sustentables, ofreciendo soluciones eficientes y estratégicas para proveer una excelente calidad, sin impactar el medio ambiente.",
    image: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp3.webp",
  },
  {
    label: "VISIÓN",
    title: "Líderes en Baja California Sur",
    text: "Ser líder de Baja California Sur en la producción de alimentos orgánicos, comercializando principalmente en nuestra localidad y creciendo progresivamente a otros estados de México, siendo sustentables y competitivos.",
    image: "https://raw.githubusercontent.com/AntonioHerrera1994/spargel/refs/heads/main/src/assets/esp4.webp",
  },
];

const values = [
  {
    title: "Pasión",
    text: "El motor detrás de cada cosecha.",
    icon: "heart",
  },
  {
    title: "Integridad",
    text: "Transparencia en cada proceso.",
    icon: "shield",
  },
  {
    title: "Inteligencia",
    text: "Decisiones basadas en datos y precisión.",
    icon: "spark",
  },
  {
    title: "Innovación",
    text: "Nuevas estrategias para el campo mexicano.",
    icon: "bulb",
  },
  {
    title: "Sustentabilidad",
    text: "Cuidamos el medio ambiente como cuidamos de ti.",
    icon: "leaf",
  },
];
---

<section class="mv" id="mision-vision">
  <div class="mv__header">
    <div class="mv__eyebrow">
      <span class="mv__eyebrow-line"></span>
      NUESTRA BRÚJULA
      <span class="mv__eyebrow-line"></span>
    </div>
    <h2 class="mv__title">Misión, Visión y Valores</h2>
  </div>

  <!-- Grid de Misión y Visión con imagen -->
  <div class="mv__pillars">
    {
      pillars.map((pillar) => (
        <div class="mv-pillar">
          <img
            src={pillar.image}
            alt={pillar.title}
            class="mv-pillar__image"
            loading="lazy"
          />
          <div class="mv-pillar__overlay"></div>
          <div class="mv-pillar__content">
            <span class="mv-pillar__label">{pillar.label}</span>
            <h3 class="mv-pillar__title">{pillar.title}</h3>
            <p class="mv-pillar__text">{pillar.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Grid de Valores -->
  <div class="mv__values">
    {
      values.map((value) => (
        <div class="value-card">
          <div class="value-card__icon">
            {value.icon === "heart" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" />
              </svg>
            )}
            {value.icon === "shield" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
              </svg>
            )}
            {value.icon === "spark" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8" />
              </svg>
            )}
            {value.icon === "bulb" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 2Z" />
              </svg>
            )}
            {value.icon === "leaf" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 4 13V7a1 1 0 0 1 1-1h6a7 7 0 0 1 7 7v0a7 7 0 0 1-7 7Z" />
                <path d="M4 13c6 0 8-4 12-4" />
              </svg>
            )}
          </div>
          <h4 class="value-card__title">{value.title}</h4>
          <p class="value-card__text">{value.text}</p>
        </div>
      ))
    }
  </div>
</section>